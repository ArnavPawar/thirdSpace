{
  "expo": {
    "name": "Third Space",
    "slug": "third-space",
    "scheme": "thirdspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f3f3f1",
      "dark": {
        "backgroundColor": "#0b0b0b"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thirdspace.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Third Space uses your location to show nearby spaces and directions."
      }
    },
    "android": {
      "package": "com.thirdspace.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Third Space needs access to your photos so you can add pictures to reviews and comments.",
          "cameraPermission": "Third Space needs access to your camera so you can take pictures for reviews and comments."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
